# Copier en .env pour changer un réglage. Chaque valeur a un défaut qui marche (mode démonstration).
# Seuls ports publiés sur la machine. Occupés (Skype, IIS, Apache…) : WEB_PORT=8080 et/ou WEB_TLS_PORT=9443.
WEB_PORT=80
WEB_TLS_PORT=8443
# La base, l'API et Ollama ne sont pas publiés (réseau interne de Docker). Développement seulement :
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d   (SALUBRI_DB_PORT=5433, SALUBRI_API_PORT=8000)
SALUBRI_COMMUNE=ouagadougou
# vide = même origine seulement (nginx sert l'interface et l'API ensemble)
SALUBRI_CORS_ORIGINS=

# Démonstration (défaut) : compte « demo » / mot de passe ouaga2026 et code de service ouaga2026, connus de
# tous ; un badge « Mode démonstration » s'affiche dans l'interface.
# Production : SALUBRI_DEMO_MODE=false. Au premier lancement, run/start génère ci-dessous un code de service
# et une clé de session aléatoires ; créez ensuite le premier admin avec run/admin <login>.
SALUBRI_DEMO_MODE=true
# code de service (scripts, droits admin) ; vide en démonstration
SALUBRI_ADMIN_TOKEN=
# clé de signature des sessions (32 caractères minimum hors démonstration)
SALUBRI_SECRET_KEY=

# Brigade Laabal : numéro WhatsApp qui reçoit les alertes des zones récidivistes (le message part par un clic de
# l'agent, jamais tout seul). +22600000000 est fictif : mettre le vrai numéro de la brigade.
SALUBRI_LAABAL_WHATSAPP=+22600000000
