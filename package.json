{
  "name": "salubri",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Salubri — front-ends (apps/web, apps/go). Le backend est dans apps/api (Python).",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:go": "pnpm --filter go dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint apps/web/src apps/go/src",
    "typecheck": "tsc --noEmit -p apps/web && tsc -b apps/go"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^15",
    "typescript-eslint": "^8"
  },
  "type": "module"
}
